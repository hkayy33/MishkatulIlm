# Copy to Fly secrets / Vercel env — never commit real values.
# .NET uses double underscores for nested config (e.g. Supabase__Url).

# ─── Fly.io (API) ─────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=db.YOUR_PROJECT.supabase.co;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
# Project root only — do NOT append /rest/v1 or /auth/v1
Supabase__Url=https://YOUR_PROJECT.supabase.co
Supabase__JwtSecret=
Supabase__ServiceRoleKey=YOUR_SERVICE_ROLE_KEY
Admin__PromotedAdminEmails=you@example.com
Stripe__SecretKey=sk_live_...
Stripe__WebhookSecret=whsec_...
Stripe__ProductId=prod_...
Stripe__PriceLookupKey=student_lessons_monthly
Stripe__ClientAppUrl=https://www.alusooliyyah.com
Flutterwave__ClientId=
Flutterwave__ClientSecret=
Flutterwave__EncryptionKey=
Flutterwave__WebhookSecretHash=
Flutterwave__ClientAppUrl=https://www.alusooliyyah.com
Flutterwave__ApiBaseUrl=https://api.flutterwave.com
# Public HTTPS URL Flutterwave can redirect to after payment (required for sandbox if checkout_url is missing).
Flutterwave__PaymentRedirectUrl=https://www.alusooliyyah.com
Cors__AllowedOrigins__0=https://www.alusooliyyah.com
Cors__AllowedOrigins__1=https://alusooliyyah.com
Cors__AllowedOrigins__2=https://al-usooliyyah.vercel.app

# ─── Vercel (Angular) — build-time only ───────────────────────
API_BASE_URL=https://mishkatulilm-api.fly.dev
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
AUTH_REDIRECT_ORIGIN=https://www.alusooliyyah.com
