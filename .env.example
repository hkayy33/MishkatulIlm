# Copy to Fly secrets / Vercel env — never commit real values.
# .NET uses double underscores for nested config (e.g. Supabase__Url).

# ─── Fly.io (API) ─────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=db.YOUR_PROJECT.supabase.co;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
Supabase__Url=https://YOUR_PROJECT.supabase.co
Supabase__JwtSecret=
Supabase__ServiceRoleKey=YOUR_SERVICE_ROLE_KEY
Admin__PromotedAdminEmails=you@example.com
Stripe__SecretKey=sk_live_...
Stripe__WebhookSecret=whsec_...
Stripe__ProductId=prod_...
Stripe__PriceLookupKey=student_lessons_monthly
Stripe__ClientAppUrl=https://YOUR_APP.vercel.app
Cors__AllowedOrigins__0=https://YOUR_APP.vercel.app
Cors__AllowedOrigins__1=https://YOUR_APP-*.vercel.app

# ─── Vercel (Angular) — build-time only ───────────────────────
API_BASE_URL=https://mishkatulilm-api.fly.dev
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
